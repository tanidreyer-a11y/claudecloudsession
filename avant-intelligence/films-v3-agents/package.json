{
  "name": "avant-agents-film",
  "version": "1.0.0",
  "private": true,
  "description": "Motion Studio film (theme-driven Remotion template)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "audio": "python3 audio/build_audio.py",
    "render": "remotion render src/index.ts Film out/master_raw.mp4 --gl=angle --codec h264 --crf 16",
    "finish": "bash \"$MOTION_STUDIO/scripts/finish.sh\" out/master_raw.mp4 out/film 25",
    "build": "npm run audio && npm run render && npm run finish",
    "still": "remotion still src/index.ts Film out/still.png --frame 60",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@fontsource/inter": "^5.0.0",
    "@remotion/media": "4.0.529",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}